{
  "manifest_version": 3,
  "name": "Chat Signals",
  "version": "0.3.2",
  "description": "Evidence-aware ChatGPT tab state and perceptual color identity.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": [
      "src/color.js",
      "src/background.js"
    ],
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/color.js",
        "src/state.js",
        "src/alerts.js",
        "src/chime.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chat-signals@sguzman.github",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
